{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "The dependency updates of droneey: on the first day of each month, between 10:00 and 18:00 Warsaw time, one pull request per repository for the minor and patch updates, one per major, the lockfile refreshed the same day, commits in the fleet's format.",
  "extends": [
    "config:recommended",
    "group:allNonMajor"
  ],
  "schedule": [
    "* 10-17 1 * *"
  ],
  "timezone": "Europe/Warsaw",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": null,
  "commitMessageLowerCase": "never",
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 10-17 1 * *"
    ]
  },
  "packageRules": [
    {
      "matchPackageNames": [
        "*"
      ],
      "semanticCommitType": "chore"
    },
    {
      "matchDepTypes": [
        "peerDependencies"
      ],
      "rangeStrategy": "widen"
    }
  ]
}
