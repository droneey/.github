{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "The dependency updates of droneey: one weekly pull request per repository for the minor and patch updates, one per major, the lockfile refreshed weekly, commits in the fleet's format.",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    "schedule:weekly"
  ],
  "timezone": "Europe/Kyiv",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": null,
  "commitMessageLowerCase": "never",
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "semanticCommitType": "chore"
    },
    {
      "matchDepTypes": ["peerDependencies"],
      "rangeStrategy": "widen"
    }
  ]
}
